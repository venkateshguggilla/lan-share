<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the NSIS installer built from the signed app.
     The workflow passes the version from package.json, so only that exact installer is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true"/>
  </parameters>
  <zip-file>
    <pe-file path="LAN-Share-Setup-${version}.exe" product-name="LAN Share">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
